{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/schemas/public-receipt-0.0.1.schema.json",
  "title": "8x8 Public Receipt 0.0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_version",
    "receipt_id",
    "source_commit",
    "state_path",
    "state_sha256",
    "issued_at",
    "reality",
    "truth_class",
    "assertions",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "0.0.1"},
    "product_version": {"const": "0.0.1"},
    "receipt_id": {"type": "string", "minLength": 8},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state_path": {"const": "state/public-state.json"},
    "state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "reality": {"const": "PUBLIC_PRESENT"},
    "truth_class": {"type": "string", "minLength": 1},
    "assertions": {
      "type": "object",
      "additionalProperties": {"type": ["boolean", "string", "number", "null"]}
    },
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
