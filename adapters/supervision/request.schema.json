{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/schemas/supervision-adapter-request-v1.json",
  "title": "8x8 Supervision Adapter Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "operation", "media_class", "detections"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "operation": {
      "type": "string",
      "enum": ["DETECTION_FILTER", "IOU_MATRIX", "NON_MAX_SUPPRESSION", "COORDINATE_CONVERSION", "ANNOTATION_METADATA"]
    },
    "media_class": {"type": "string", "enum": ["SYNTHETIC", "PUBLIC_LICENSED"]},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "detections": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["xyxy", "confidence", "class_id"],
        "properties": {
          "xyxy": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0}
            ],
            "items": false
          },
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "class_id": {"type": "integer", "minimum": 0},
          "tracker_id": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "iou_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "image_width": {"type": "integer", "minimum": 1, "maximum": 16384},
        "image_height": {"type": "integer", "minimum": 1, "maximum": 16384}
      }
    }
  }
}
