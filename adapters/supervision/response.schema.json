{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/schemas/supervision-adapter-response-v1.json",
  "title": "8x8 Supervision Adapter Response V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "status", "operation", "result", "evidence"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "status": {"type": "string", "enum": ["PASS", "REJECTED", "ERROR"]},
    "operation": {
      "type": "string",
      "enum": ["DETECTION_FILTER", "IOU_MATRIX", "NON_MAX_SUPPRESSION", "COORDINATE_CONVERSION", "ANNOTATION_METADATA"]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_count", "output_count"],
      "properties": {
        "input_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "output_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "selected_indices": {
          "type": "array",
          "maxItems": 1000,
          "items": {"type": "integer", "minimum": 0}
        },
        "matrix_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "annotation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "upstream_commit", "input_sha256", "output_sha256", "network_used", "private_data_used"],
      "properties": {
        "adapter_id": {"const": "8x8.supervision.adapter.v1"},
        "upstream_commit": {"const": "bc20dd19fbc7b6cceaec447f1182346ca9158523"},
        "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "network_used": {"const": false},
        "private_data_used": {"const": false},
        "model_used": {"const": false},
        "cleanup_complete": {"type": "boolean"}
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "maxLength": 256}
    }
  }
}
