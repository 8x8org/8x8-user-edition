{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://8x8.org/schemas/8x8-user-identity-0.0.1.schema.json",
  "title": "8x8 User Identity Contract 0.0.1",
  "type": "object",
  "required": [
    "schema_version",
    "user_id",
    "eight_x_eight_id",
    "handle",
    "reality",
    "account_state",
    "created_at",
    "privacy",
    "consents"
  ],
  "properties": {
    "schema_version": {"const": "0.0.1"},
    "user_id": {"type": "string", "pattern": "^usr_[A-Za-z0-9_-]{16,}$"},
    "eight_x_eight_id": {"type": "string", "pattern": "^8x8_[A-Za-z0-9_-]{16,}$"},
    "handle": {"type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[A-Za-z0-9_.-]+$"},
    "display_name": {"type": "string", "maxLength": 80},
    "reality": {"enum": ["PROTECTED_BETA", "PUBLIC_PRESENT"]},
    "account_state": {"enum": ["PENDING_VERIFICATION", "ACTIVE", "RECOVERY", "SUSPENDED", "DELETION_PENDING", "DELETED"]},
    "created_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"},
    "recovery_version": {"type": "integer", "minimum": 1},
    "privacy": {
      "type": "object",
      "required": ["profile_visibility", "presence_visibility"],
      "properties": {
        "profile_visibility": {"enum": ["PRIVATE", "ECOSYSTEM", "PUBLIC"]},
        "presence_visibility": {"enum": ["HIDDEN", "GLOBAL_ONLY", "COUNTRY", "REGION", "APPROXIMATE_CITY"]}
      },
      "additionalProperties": false
    },
    "consents": {
      "type": "object",
      "required": ["compute", "storage", "telemetry", "remote_support", "economy", "marketing"],
      "properties": {
        "compute": {"type": "boolean", "default": false},
        "storage": {"type": "boolean", "default": false},
        "telemetry": {"type": "boolean", "default": false},
        "remote_support": {"type": "boolean", "default": false},
        "economy": {"type": "boolean", "default": false},
        "marketing": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "session_policy": {
      "type": "object",
      "properties": {
        "passkey_preferred": {"const": true},
        "session_listing_required": {"const": true},
        "revocation_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
